{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Go: server",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/backend/cmd/server"
    },
    {
      "name": "Frontend: Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend"
    }
  ],
  "compounds": [
    {
      "name": "Full stack",
      "configurations": ["Go: server", "Frontend: Chrome"]
    }
  ]
}